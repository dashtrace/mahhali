# /opt/mahhali/.env on the server. Never commit the real file.
DOMAIN=mahhali.example.com
APP_IMAGE=ghcr.io/dashtrace/mahhali
POSTGRES_USER=mahhali
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mahhali
BETTER_AUTH_SECRET=change-me-long-random-32-plus-characters
# Sent by host cron to /api/cron/* (see crontab in deploy/README.md).
CRON_SECRET=change-me-long-random
# Email (Resend). Verify the sending domain first or mail lands in spam.
RESEND_API_KEY=
MAIL_FROM=Mahhali <orders@mahhali.example.com>
# Stripe test mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
