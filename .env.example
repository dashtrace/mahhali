# Copy to .env for local development.
DATABASE_URL="postgresql://mahhali:mahhali@localhost:5432/mahhali"
# Integration tests TRUNCATE every table: always point them at a separate database.
TEST_DATABASE_URL="postgresql://mahhali:mahhali@localhost:5432/mahhali_test"
# Any random string of 32+ characters, e.g. from `npx auth secret`.
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional below. Without them the app still runs: emails are logged instead of sent,
# billing answers 503, and the scheduled jobs refuse every call.
# Header value host cron sends to /api/cron/* (x-cron-secret).
CRON_SECRET=""
# Transactional email (order confirmations, review invites, staff invites).
RESEND_API_KEY=""
MAIL_FROM="Mahhali <orders@example.com>"
# Stripe test mode: secret key, the Pro plan's price id and the webhook signing secret.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""
# Where logos and product photos are written; defaults to ./uploads.
UPLOAD_DIR=""
