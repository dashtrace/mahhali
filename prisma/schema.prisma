generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               String?
  banned             Boolean?            @default(false)
  banReason          String?
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  invitations        Invitation[]
  deliveredOrders    Order[]             @relation("DeliveredBy")
  adminActions       AdminAuditLog[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  productImports     ProductImport[]
  importPhotoLinks   ImportPhotoLink[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeShopId       String?
  /// The shop picked while connecting an AI assistant; kept apart from activeShopId so the dashboard does not switch shops.
  connectShopId      String?
  impersonatedBy     String?
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth's "organization", renamed. Fields below metadata are Shop Link's own.
model Shop {
  id                     String           @id
  name                   String
  slug                   String
  logo                   String?
  createdAt              DateTime         @default(now())
  metadata               String?
  currency               Currency         @default(USD)
  /// Pounds per dollar, set by the owner. Frozen onto each order.
  usdLbpRate             Decimal?         @db.Decimal(14, 2)
  /// Next order number; incremented inside the order transaction.
  nextOrderSeq           Int              @default(1001)
  plan                   String           @default("free")
  theme                  Json?
  suspended              Boolean          @default(false)
  /// "en" or "ar": the language customers see on the public pages.
  language               String           @default("en")
  /// Default delivery fee added to catalogue orders, in the shop currency.
  deliveryFeeMinor       BigInt           @default(0)
  /// Reconciliation ignores differences up to this much (change given in pounds).
  codToleranceMinor      BigInt           @default(0)
  /// Orders left in New this long are cancelled and their stock released. Null = never.
  autoCancelHours        Int?
  /// Shown on the catalogue as a WhatsApp button, E.164.
  whatsappPhone          String?
  /// Pilot baseline from sign-up: the "before" numbers for the outcome metrics.
  baselineOrdersPerDay   Int?
  baselineConfirmMinutes Int?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  /// Storefront copy and links. Length limits are CHECKs in the migration.
  tagline                String?
  about                  String?
  shippingInfo           String?
  /// https only, instagram.com or facebook.com hosts (checked by the service).
  instagramUrl           String?
  facebookUrl            String?
  /// "image-and-name", "image-only" or "name-only".
  logoMode               String           @default("image-and-name")
  /// Home page highlight: "bestsellers", "new", "featured", "category" or "hidden".
  homeSection            String           @default("category")
  /// The category the "category" highlight shows; null (or a deleted one) means the first. No FK: the service checks the shop.
  homeCategoryId         String?
  showTestimonials       Boolean          @default(true)
  memberships            Membership[]
  invitations            Invitation[]
  products               Product[]
  variants               Variant[]
  productImages          ProductImage[]
  customers              Customer[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderEvents            OrderEvent[]
  stockMovements         StockMovement[]
  couriers               Courier[]
  remittances            Remittance[]
  remittanceSupplements  RemittanceSupplement[]
  remittanceResolutions  RemittanceResolution[]
  orderCashResolutions   OrderCashResolution[]
  remittanceLines        RemittanceLine[]
  reviewInvites          ReviewInvite[]
  reviews                Review[]
  heroSlides             HeroSlide[]
  categories             Category[]
  testimonials           Testimonial[]
  productImports         ProductImport[]
  mcpToolCalls           McpToolCall[]
  importPhotoLinks       ImportPhotoLink[]

  @@unique([slug])
  @@map("shop")
}

model Membership {
  id        String   @id
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner, manager, staff or delivery
  role      String   @default("staff")
  /// For delivery users: the courier they act for.
  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id        String   @id
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email     String
  role      String?
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviterId String
  user      User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  /// For delivery invites: the courier the new user will act for.
  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Shop Link domain. Every tenant table carries shopId; repositories always
// filter by it. Money is BigInt: USD in cents, LBP in whole pounds.
// ---------------------------------------------------------------------------

enum Currency {
  USD
  LBP
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderEventType {
  STATUS
  COURIER
}

enum OrderSource {
  CATALOGUE
  MANUAL
}

enum StockReason {
  RESERVE
  RELEASE
  SHIP
  RESTOCK
  ADJUST
}

enum CourierType {
  COMPANY
  INDIVIDUAL
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model Product {
  id                String         @id @default(cuid())
  shopId            String
  shop              Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  status            ProductStatus  @default(ACTIVE)
  ratingAvg         Decimal        @default(0) @db.Decimal(3, 2)
  ratingCount       Int            @default(0)
  /// Same shop only; the service checks. Deleting the category leaves the product uncategorised.
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured          Boolean        @default(false)
  /// [{ label, value }], at most 12.
  specs             Json?
  /// A customer note on each ordered item (e.g. engraving). A label means enabled.
  customLabel       String?
  customPlaceholder String?
  customRequired    Boolean        @default(false)
  /// CHECK 1..500 in the migration.
  customMaxLength   Int            @default(240)
  /// Option names, e.g. ["Size", "Colour"] or ["SPF"]; at most 3 (CHECK in the migration).
  options           String[]       @default([])
  /// The AI-assistant or CSV import that created it; undo archives exactly these.
  importId          String?
  import            ProductImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  variants          Variant[]
  images            ProductImage[]
  reviews           Review[]

  @@index([shopId, status])
  @@index([importId])
  @@map("product")
}

model Category {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([shopId, name])
  @@map("category")
}

/// A promo banner on the storefront home page; at most 6 per shop.
model HeroSlide {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  imageUrl  String
  kicker    String?
  title     String
  body      String?
  position  Int
  createdAt DateTime @default(now())

  @@index([shopId, position])
  @@map("hero_slide")
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Shop feedback a customer agreed to show publicly; shown once the shop approves it.
model Testimonial {
  id            String            @id @default(cuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  authorName    String
  message       String
  status        TestimonialStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  moderatedAt   DateTime?
  moderatedById String?

  @@index([shopId, status, createdAt])
  @@map("testimonial")
}

model Variant {
  id             String          @id @default(cuid())
  shopId         String
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// One value per product option, by position; "" when blank.
  optionValues   String[]        @default([])
  sku            String?
  /// In the shop's currency: cents for USD, whole pounds for LBP.
  priceMinor     BigInt
  /// Can still be ordered. CHECK (available >= 0) in the migration.
  available      Int             @default(0)
  /// Promised to open orders. CHECK (reserved >= 0) in the migration.
  reserved       Int             @default(0)
  /// Hidden from the catalogue; kept because old orders point at it.
  archived       Boolean         @default(false)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, optionValues])
  @@index([shopId])
  @@map("variant")
}

model ProductImage {
  id          String  @id @default(cuid())
  shopId      String
  shop        Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  /// The option value this photo shows (e.g. a colour); null for every variant.
  optionValue String?
  position    Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  /// E.164, e.g. +96171123456
  phone     String
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([shopId, phone])
  @@map("customer")
}

model Order {
  id                String          @id @default(cuid())
  shopId            String
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Per shop, never reused.
  number            Int
  /// Customer's private tracking link.
  publicToken       String          @unique
  idempotencyKey    String?
  status            OrderStatus     @default(NEW)
  source            OrderSource     @default(CATALOGUE)
  /// Staff member who entered a manual order.
  createdByUserId   String?
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  /// Name, phone and email as given on this order.
  customerName      String
  customerPhone     String
  customerEmail     String?
  governorate       String
  district          String
  area              String
  addressLine       String
  landmark          String?
  notes             String?
  courierId         String?
  courier           Courier?        @relation(fields: [courierId], references: [id])
  currency          Currency
  usdLbpRate        Decimal?        @db.Decimal(14, 2)
  subtotalMinor     BigInt
  deliveryFeeMinor  BigInt          @default(0)
  totalMinor        BigInt
  /// Cash the courier must collect, in the order currency.
  codMinor          BigInt
  /// Cash the courier said they collected at the door.
  reportedUsdCents  BigInt?
  reportedLbp       BigInt?
  failureReason     String?
  deliveredByUserId String?
  deliveredBy       User?           @relation("DeliveredBy", fields: [deliveredByUserId], references: [id])
  firstContactAt    DateTime        @default(now())
  confirmedAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  events            OrderEvent[]
  stockMovements    StockMovement[]
  remittanceLine    RemittanceLine?
  cashResolution     OrderCashResolution?
  reviewInvite      ReviewInvite?

  @@unique([shopId, number])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, status, createdAt])
  @@index([shopId, courierId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  shopId         String
  shop           Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant @relation(fields: [variantId], references: [id])
  /// Product name and option values at order time.
  nameSnapshot   String
  unitPriceMinor BigInt
  qty            Int
  /// The customer's customization text for this line, if the product asks for one.
  note           String?
  review         Review?

  @@index([orderId])
  @@map("order_item")
}

model OrderEvent {
  id          String         @id @default(cuid())
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  fromValue   String?
  toValue     String
  /// e.g. why a delivery failed or an order was cancelled.
  note        String?
  /// Empty when the customer or the system made the change.
  actorUserId String?
  at          DateTime       @default(now())

  @@index([orderId, at])
  @@map("order_event")
}

model StockMovement {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id])
  delta       Int
  reason      StockReason
  /// Why stock was adjusted by hand, e.g. "damaged" or "recount".
  note        String?
  actorUserId String?
  at          DateTime    @default(now())

  @@index([variantId, at])
  @@map("stock_movement")
}

model Courier {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type        CourierType
  name        String
  phone       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  orders      Order[]
  remittances Remittance[]
  memberships Membership[]
  invitations Invitation[]

  @@index([shopId])
  @@map("courier")
}

model Remittance {
  id               String           @id @default(cuid())
  shopId           String
  shop             Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  courierId        String
  courier          Courier          @relation(fields: [courierId], references: [id])
  amountUsdCents   BigInt           @default(0)
  amountLbp        BigInt           @default(0)
  receivedAt       DateTime
  reference        String?
  recordedByUserId String?
  createdAt        DateTime         @default(now())
  lines            RemittanceLine[]
  supplements      RemittanceSupplement[]
  resolution       RemittanceResolution?

  @@index([shopId, courierId])
  @@map("remittance")
}

model RemittanceLine {
  id                String     @id @default(cuid())
  shopId            String
  shop              Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  remittanceId      String
  remittance        Remittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  /// An order's cash is settled once.
  orderId           String     @unique
  order             Order      @relation(fields: [orderId], references: [id])
  collectedUsdCents BigInt     @default(0)
  collectedLbp      BigInt     @default(0)
  /// Courier fee deducted, in the order currency.
  feeMinor          BigInt     @default(0)

  @@map("remittance_line")
}

// Append-only receipts: additional money received AFTER the initial remittance.
model RemittanceSupplement {
  id               String     @id @default(cuid())
  shopId           String
  shop             Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  remittanceId     String
  remittance       Remittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  amountUsdCents   BigInt     @default(0)
  amountLbp        BigInt     @default(0)
  reason           String
  recordedByUserId String
  requestKey       String
  createdAt        DateTime   @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, remittanceId])
  @@map("remittance_supplement")
}

// An explicit owner/manager decision to accept a remaining handover difference.
model RemittanceResolution {
  id               String     @id @default(cuid())
  shopId           String
  shop             Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  remittanceId     String     @unique
  remittance       Remittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  reason           String
  recordedByUserId String
  createdAt        DateTime   @default(now())

  @@map("remittance_resolution")
}

// An explicit decision accepting an order-level due-vs-collected discrepancy.
model OrderCashResolution {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason           String
  recordedByUserId String
  createdAt        DateTime @default(now())

  @@map("order_cash_resolution")
}

model ReviewInvite {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Only a hash of the link token is stored.
  tokenHash   String    @unique
  expiresAt   DateTime
  emailSentAt DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("review_invite")
}

model Review {
  id             String       @id @default(cuid())
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// One review per purchased item.
  orderItemId    String       @unique
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// 1 to 5. CHECK in the migration.
  rating         Int
  comment        String?
  authorName     String
  status         ReviewStatus @default(PENDING)
  hiddenByUserId String?
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@index([productId, status])
  @@map("review")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id])
  shopId      String?
  /// e.g. "GET /api/admin/shops/abc/orders"
  action      String
  at          DateTime @default(now())

  @@index([at])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// OAuth 2.1 provider (@better-auth/oauth-provider). Claude and ChatGPT register
// here as clients; shop members connect them to one shop. The plugin owns the
// shape of these tables. referenceId on consents and tokens holds the shopId
// the user picked when connecting.

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  /// Null for clients that registered themselves (Claude, ChatGPT).
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

/// A protected API. We have one: the MCP endpoint, seeded from the plugin config.
model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String             @id
  /// SHA-256 of the token, never the token itself.
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The shop this connection is for.
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([referenceId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  /// SHA-256 of the token, never the token itself. Looked up on every MCP call.
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The shop this connection is for.
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@index([referenceId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The shop the user approved access to.
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@index([referenceId])
  @@map("oauth_consent")
}

/// Replay protection for private_key_jwt client assertions; unused by our clients but part of the plugin schema.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// ---------------------------------------------------------------------------
// AI assistants (MCP)

enum ImportSource {
  MCP
  DASHBOARD
}

enum ImportStatus {
  /// Waiting for the user to confirm; expires at expiresAt.
  PREVIEWED
  /// The user asked for changes and a newer preview took its place.
  SUPERSEDED
  CONFIRMED
  UNDONE
}

/// A bulk product import: the preview a user reviews, then the products it created.
model ProductImport {
  id           String       @id @default(cuid())
  shopId       String
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       ImportSource
  status       ImportStatus @default(PREVIEWED)
  /// The validated products, ready to create.
  rows         Json
  /// What the user was shown: per-row problems, duplicates, new categories.
  report       Json
  productCount Int
  variantCount Int
  expiresAt    DateTime
  confirmedAt  DateTime?
  undoneAt     DateTime?
  createdAt    DateTime     @default(now())
  products     Product[]
  photoLink    ImportPhotoLink?

  @@index([shopId, userId, status])
  @@map("product_import")
}

/// A no-login page link for adding photos to the products of one confirmed
/// import, from a phone. One per import: a new link replaces the old one.
model ImportPhotoLink {
  id          String        @id @default(cuid())
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  importId    String        @unique
  import      ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// Only a hash of the link token is stored.
  tokenHash   String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  @@index([shopId])
  @@map("import_photo_link")
}

enum McpOutcome {
  OK
  /// The role or the granted scopes do not allow the tool.
  DENIED
  /// The input failed validation.
  INVALID
  /// Any other error (not found, conflict, internal).
  ERROR
}

/// One row per MCP tool call. Never stores the call's input or output.
model McpToolCall {
  id         String     @id @default(cuid())
  shopId     String
  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId     String
  /// OauthClient.clientId; no FK so the log outlives a deleted client.
  clientId   String
  tool       String
  outcome    McpOutcome
  errorCode  String?
  durationMs Int
  createdAt  DateTime   @default(now())

  @@index([shopId, createdAt])
  @@index([userId, clientId, createdAt])
  @@map("mcp_tool_call")
}
